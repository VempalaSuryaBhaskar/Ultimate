pipeline {

   agent {
       docker {
           image 'node:24.11.0-alpine'
           args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
       }
   }

    stages {
        stage('Checkout') {
            steps {
                echo 'Checkout completed'
                sh 'pwd'
                sh 'ls -la'
            }
        }
        stage('Build and Test') {
            steps {
                dir('node-ci-cd') {
                    sh '''
                        echo "Node version"
                        node --version

                        echo "NPM version"
                        npm --version

                        echo "Installing dependencies"
                        npm install

                        echo "Running tests"
                    '''
                }
            }
        }
     stage('Static Code Analysis') {
             environment {
                 SONAR_URL = 'http://13.63.56.17:9000'
             }
             steps {
                 withCredentials([
                     string( credentialsId: 'sonarqube', variable: 'SONAR_AUTH_TOKEN' )
                 ]) {
                     dir('node-ci-cd') {
                         sh '''
                             echo "Installing Java"

                             apk add --no-cache openjdk17-jre
                             echo "Checking Java"        
                             which java
                             java -version
                             echo "Checking Node"
         
                             node --version
                             npm --version
         
                             echo "Running SonarScanner"
         
                             npx --yes sonar-scanner \
                            -Dsonar.projectKey=node-ci-cd \
                            -Dsonar.sources=. \
                            -Dsonar.host.url=${SONAR_URL} \
                            -Dsonar.login=${SONAR_AUTH_TOKEN}
                         '''
                     }
                 }
             }
         }
      stage('Build and Push Docker Image') {
            environment {
              DOCKER_IMAGE = "suryabhaskarvempala/ultimate-cicd:${BUILD_NUMBER}"
              // DOCKERFILE_LOCATION = "java-maven-sonar-argocd-helm-k8s/spring-boot-app/Dockerfile"
              REGISTRY_CREDENTIALS = credentials('docker-cred')
            }
            steps {
              script {
                  sh 'apk add --no-cache docker-cli' 
                  sh 'cd node-ci-cd && docker build -t ${DOCKER_IMAGE} .'
                  def dockerImage = docker.image("${DOCKER_IMAGE}")
                  docker.withRegistry('https://index.docker.io/v1/', "docker-cred") {
                      dockerImage.push()
                  }
              }
            }
          }
        stage('Update Deployment File') {
              environment {
                  GIT_REPO_NAME = "Ultimate"
                  GIT_USER_NAME = "VempalaSuryaBhaskar"
              }
              steps {
                  withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {
                      sh '''
                          apk add --no-cache git
                          git --version
                          git config user.email "vempalasvdbhaskar@gmail.com"
                          git config user.name "VempalaSuryaBhaskar"
                          BUILD_NUMBER=${BUILD_NUMBER}
                          sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" manifests/deployment.yml
                          git add manifests/deployment.yml
                          git commit -m "Update deployment image to version ${BUILD_NUMBER}"
                          git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME} HEAD:main
                      '''
                  }
              }
          }
        }

    post {

        success {
            echo 'PIPELINE SUCCESSFUL'
        }

        failure {
            echo 'PIPELINE FAILED'
        }

        always {
            echo 'Pipeline execution completed.'
        }
    }
}
