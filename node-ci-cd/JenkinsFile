pipeline {

  agent {
    docker {
      image 'node:24.11.0-alpine'
      args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
    }
  }

  stages {

    stage('Checkout') {
      steps {
        sh 'echo "Checkout completed"'
        sh 'ls -la'
      }
    }

    stage('Build and Test') {
      steps {
        dir('node-ci-cd') {
          sh '''
            echo "Node version:"
            node --version

            echo "NPM version:"
            npm --version

            echo "Installing dependencies..."
            npm install

            echo "Running tests..."
          '''
        }
      }
    }

    stage('Static Code Analysis') {

      environment {
        SONAR_URL = "http://13.63.56.17:9000"
      }

      steps {

        withCredentials([
          string(
            credentialsId: 'sonarqube',
            variable: 'SONAR_AUTH_TOKEN'
          )
        ]) {

          /*
           * Do NOT use:
           *
           * npx sonar-scanner
           *
           * because your current pipeline is failing there.
           */

          dir('node-ci-cd') {

            sh '''
              sonar-scanner \
                -Dsonar.projectKey=node-ci-cd \
                -Dsonar.sources=. \
                -Dsonar.host.url=${SONAR_URL} \
                -Dsonar.token=${SONAR_AUTH_TOKEN}
            '''
          }
        }
      }
    }

    stage('Build and Push Docker Image') {

      environment {
        DOCKER_IMAGE = "suryabhaskarvempala/ultimate-cicd:${BUILD_NUMBER}"
      }

      steps {

        script {

          dir('node-ci-cd') {

            sh '''
              echo "Building Docker image..."
              docker build -t ${DOCKER_IMAGE} .
            '''

            def dockerImage = docker.image("${DOCKER_IMAGE}")

            docker.withRegistry(
              'https://index.docker.io/v1/',
              'docker-cred'
            ) {

              dockerImage.push()
            }
          }
        }
      }
    }

    stage('Update Deployment File') {

      environment {
        GIT_REPO_NAME = "Ultimate"
        GIT_USER_NAME = "VempalaSuryaBhaskar"
      }

      steps {

        withCredentials([
          string(
            credentialsId: 'github',
            variable: 'GITHUB_TOKEN'
          )
        ]) {

          sh '''
            git config user.email "vempalasvdbhaskar@gmail.com"
            git config user.name "VempalaSuryaBhaskar"

            echo "Updating Kubernetes deployment image..."

            sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" \
              manifests/deployment.yml

            git add manifests/deployment.yml

            git commit \
              -m "Update deployment image to version ${BUILD_NUMBER}" \
              || true

            git push \
              https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git \
              HEAD:main
          '''
        }
      }
    }
  }
}
