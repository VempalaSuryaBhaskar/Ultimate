pipeline {

   agent {
       docker {
           image 'node:24.11.0-alpine'
           args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
       }
   }

    stages {
        stage('Checkout') {
            steps {
                echo 'Checkout completed'
                sh 'pwd'
                sh 'ls -la'
            }
        }
        stage('Build and Test') {
            steps {

                dir('node-ci-cd') {

                    sh '''
                        echo "================================="
                        echo "Node version"
                        echo "================================="
                        node --version

                        echo "================================="
                        echo "NPM version"
                        echo "================================="
                        npm --version

                        echo "================================="
                        echo "Installing dependencies"
                        echo "================================="
                        npm install

                        echo "================================="
                        echo "Running tests"
                        echo "================================="
                    '''
                }
            }
        }
      stage('Static Code Analysis') {
    environment {
        SONAR_URL = 'http://13.63.56.17:9000'
    }

    steps {
        withCredentials([
            string(
                credentialsId: 'sonarqube',
                variable: 'SONAR_AUTH_TOKEN'
            )
        ]) {
            dir('node-ci-cd') {
                sh '''
                    echo "================================="
                    echo "Checking Node and NPM"
                    echo "================================="
                    node --version
                    npm --version

                    echo "================================="
                    echo "Checking npx"
                    echo "================================="
                    which npx
                    npx --version

                    echo "================================="
                    echo "Downloading SonarScanner"
                    echo "================================="

                    npx --yes sonar-scanner --version || true

                    echo "================================="
                    echo "Finding SonarScanner"
                    echo "================================="

                    SCANNER_PATH=$(find /root/.npm/_npx \
                        -type f \
                        -path '*/sonar-scanner/bin/sonar-scanner' \
                        | head -1)

                    echo "Scanner path:"
                    echo "$SCANNER_PATH"

                    echo "================================="
                    echo "Permissions"
                    echo "================================="

                    ls -l "$SCANNER_PATH"

                    echo "================================="
                    echo "SonarScanner script around line 59"
                    echo "================================="

                    nl -ba "$SCANNER_PATH" | sed -n '50,65p'

                    echo "================================="
                    echo "File information"
                    echo "================================="

                    file "$SCANNER_PATH"

                    echo "================================="
                    echo "Java check"
                    echo "================================="

                    which java || true
                    java -version || true
                '''
            }
        }
    }
}
        stage('Build and Push Docker Image') {

            environment {
                DOCKER_IMAGE = "suryabhaskarvempala/ultimate-cicd:${BUILD_NUMBER}"
            }

            steps {

                script {

                    dir('node-ci-cd') {

                        sh '''
                            echo "================================="
                            echo "Building Docker image"
                            echo "================================="

                            docker build \
                                -t ${DOCKER_IMAGE} \
                                .
                        '''

                        echo "Docker image: ${DOCKER_IMAGE}"

                        def dockerImage = docker.image("${DOCKER_IMAGE}")

                        docker.withRegistry(
                            'https://index.docker.io/v1/',
                            'docker-cred'
                        ) {

                            echo "Pushing Docker image to Docker Hub..."

                            dockerImage.push()

                            echo "Docker image pushed successfully."
                        }
                    }
                }
            }
        }


        // =========================================================
        // 5. UPDATE KUBERNETES DEPLOYMENT
        // =========================================================
        stage('Update Deployment File') {

            environment {
                GIT_REPO_NAME = 'Ultimate'
                GIT_USER_NAME = 'VempalaSuryaBhaskar'
            }

            steps {

                withCredentials([
                    string(
                        credentialsId: 'github',
                        variable: 'GITHUB_TOKEN'
                    )
                ]) {

                    sh '''
                        echo "================================="
                        echo "Updating Kubernetes deployment"
                        echo "================================="

                        git config user.email "vempalasvdbhaskar@gmail.com"
                        git config user.name "VempalaSuryaBhaskar"

                        echo "Current deployment file:"
                        cat manifests/deployment.yml

                        echo "Replacing Docker image tag..."

                        sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" \
                            manifests/deployment.yml

                        echo "Updated deployment file:"
                        cat manifests/deployment.yml

                        git add manifests/deployment.yml

                        git commit \
                            -m "Update deployment image to version ${BUILD_NUMBER}" \
                            || true

                        echo "Pushing updated deployment file to GitHub..."

                        git push \
                            https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git \
                            HEAD:main

                        echo "Deployment file pushed successfully."
                    '''
                }
            }
        }
    }

    post {

        success {
            echo '================================='
            echo 'PIPELINE SUCCESSFUL'
            echo '================================='
        }

        failure {
            echo '================================='
            echo 'PIPELINE FAILED'
            echo '================================='
        }

        always {
            echo 'Pipeline execution completed.'
        }
    }
}
