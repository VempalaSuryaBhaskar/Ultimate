pipeline {
    agent {
        docker {
            image 'node:24.11.0-alpine'
            args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    triggers {
        githubPush()
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Checkout completed'
                sh 'pwd'
                sh 'ls -la'
            }
        }
        stage('Build and Test') {
            steps {
                dir('node-ci-cd') {
                    sh '''
                        echo "Node version"
                        node --version

                        echo "NPM version"
                        npm --version

                        echo "Installing dependencies"
                        npm install

                        echo "Running tests"
                    '''
                }
            }
        }
        stage('Build and Push Docker Image') {
            environment {
                DOCKER_IMAGE = "suryabhaskarvempala/ultimate-cicd:${BUILD_NUMBER}"
                REGISTRY_CREDENTIALS = credentials('docker-cred')
            }
            steps {
                script {
                    sh 'apk add --no-cache docker-cli'
                    sh '''
                        cd node-ci-cd
                        docker build -t ${DOCKER_IMAGE} .
                    '''
                    def dockerImage = docker.image("${DOCKER_IMAGE}")

                    docker.withRegistry( 'https://index.docker.io/v1/', 'docker-cred' ) {
                        dockerImage.push()
                    }
                }
            }
        }

        stage('Update GitOps Repository') {
            environment {
                GIT_REPO_NAME = "Ultimate-GitOps"
                GIT_USER_NAME = "VempalaSuryaBhaskar"
            }

            steps {
                withCredentials([
                    string(credentialsId: 'github', variable: 'GITHUB_TOKEN')
                ]) {
                    sh '''
                        apk add --no-cache git

                        echo "Cloning GitOps repository..."

                        git clone https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git gitops

                        echo "GitOps repository cloned"

                        cd gitops

                        echo "Current directory:"
                        pwd

                        echo "Git status:"
                        git status

                        echo "Configuring Git:"
                        git config user.email "vempalasvdbhaskar@gmail.com"
                        git config user.name "VempalaSuryaBhaskar"

                        echo "Updating deployment image..."

                        sed -i -E "s#suryabhaskarvempala/ultimate-cicd:[0-9]+#suryabhaskarvempala/ultimate-cicd:${BUILD_NUMBER}#g" manifests/deployment.yml

                        echo "Updated deployment:"
                        cat manifests/deployment.yml

                        echo "Git diff:"
                        git diff

                        echo "Adding deployment file:"
                        git add manifests/deployment.yml

                        echo "Committing changes:"
                        git commit -m "Update deployment image to version ${BUILD_NUMBER}"

                        echo "Pushing changes:"
                        git push origin main
                    '''
                }
            }
        }
    }

    post {

        success {
            echo 'PIPELINE SUCCESSFUL'
        }

        failure {
            echo 'PIPELINE FAILED'
        }

        always {
            echo 'Pipeline execution completed.'
        }
    }
}
